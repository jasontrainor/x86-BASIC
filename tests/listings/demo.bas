10 REM Spectrum-style listing
20 BORDER 1: PAPER 0: INK 7: BRIGHT 0: CLS
30 POKE 23692,255: POKE 23658,0
40 FOR n=0 TO 7: READ a: POKE USR "a"+n,a: NEXT n
50 DATA BIN 00111100,BIN 01111110,BIN 11011011,BIN 11111111
60 DATA BIN 11111111,BIN 10111101,BIN 11000011,BIN 01111110
70 DIM s(5): DIM n$(3,8)
80 LET n$(1)="ALICE": LET n$(2)="BOB": LET n$(3)="CAROL"
90 FOR i=1 TO 5: LET s(i)=INT (RND*100): NEXT i
100 PRINT AT 0,0; INK 6; PAPER 1; BRIGHT 1;"HIGH SCORES"
110 FOR i=1 TO 3: PRINT TAB 2;i;". ";n$(i);TAB 16;s(i): NEXT i
120 PRINT AT 10,10; FLASH 1;"\a"; FLASH 0;" ALIEN"
130 LET a$="SCROLLING MESSAGE ": FOR j=1 TO 3: LET a$=a$(2 TO )+a$(1): NEXT j: PRINT a$
140 PLOT 128,88: DRAW 50,0,PI: CIRCLE 128,88,40: DRAW OVER 1;-10,-10
150 GO SUB 1000
160 PRINT #0;AT 0,0;"PRESS A KEY"
170 PAUSE 1
180 IF INKEY$="" THEN GO TO 200
190 LET k=CODE INKEY$
200 PRINT AT 21,0;"SCORE: ";VAL "s(1)+s(2)";" ";STR$ (s(3)*2);" ";LEN n$(1)
210 STOP
1000 BEEP .05,10: BEEP .05,12: RETURN
