10 REM Colours, text and graphics
20 BORDER 1: PAPER 7: INK 0: CLS
30 PRINT AT 0,6; PAPER 1; INK 7; BRIGHT 1;" x86 BASIC for PCs "
40 FOR c=0 TO 7
50 PRINT AT 2,c*4; PAPER c; INK 9;"    "
60 PRINT AT 3,c*4; PAPER c; INK 9; BRIGHT 1;"    "
70 NEXT c
80 FOR r=10 TO 60 STEP 10
90 INK r/10: CIRCLE 70,80,r
100 NEXT r
110 INK 0
120 FOR a=0 TO 2*PI STEP PI/12
130 PLOT 190,80: DRAW 50*COS a,50*SIN a
140 NEXT a
150 INK 2: PRINT AT 19,3;"PRINT  PLOT  DRAW  CIRCLE"
160 PRINT AT 20,3; INK 1;"BORDER PAPER INK  BRIGHT"
